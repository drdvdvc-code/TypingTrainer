<UserControl x:Class="TypingTrainer.Views.TypingTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource DarkBgBrush}" MouseMove="MainGrid_MouseMove" ClipToBounds="True">

        <!-- 1. Анимированный фон (345.png) -->
        <Image Source="/Images/345.png" 
               Stretch="UniformToFill" 
               Opacity="0.8"
               RenderTransformOrigin="0.5,0.5"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                    <TranslateTransform x:Name="ImageMovement" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- 2. Затемнение для читаемости -->
        <Rectangle Fill="{StaticResource DarkBgBrush}" Opacity="0.5" IsHitTestVisible="False"/>

        <!-- 3. Основной интерфейс -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка с прогрессом и ДИНАМИЧНЫМ КОМБО -->
            <Border Background="{StaticResource PrimaryBrush}" Padding="20,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Время: " Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Time}" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="   Прогресс: " Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Progress}" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- ⚠️ ДИНАМИЧНОЕ КОМБО -->
                    <Border x:Name="ComboContainer" Background="#33FFFFFF" CornerRadius="15" Padding="10,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="COMBO " Foreground="#DDDDDD" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="ComboText" Text="{Binding Combo}" 
                                       Foreground="White" FontWeight="Black" FontSize="20"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="ComboScale" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="ComboGlow" Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Карточка с текстом -->
            <Border Grid.Row="1" x:Name="TypingArea" Margin="30,20,30,20" Padding="30"
                    Background="{StaticResource DarkBrush}" CornerRadius="10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ShakeTransform" />
                </Border.RenderTransform>

                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ItemsControl ItemsSource="{Binding DisplayChars}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" 
                                           Foreground="{Binding Foreground}"
                                           FontFamily="{StaticResource MonoFont}" 
                                           FontSize="22" 
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Следующий символ: " Foreground="{StaticResource LightBrush}" FontSize="14"/>
                        <TextBlock Text="{Binding CurrentChar}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="24"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>

                    <TextBox x:Name="TypingBox" Grid.Row="2"
                             FontFamily="{StaticResource MonoFont}" FontSize="20"
                             Foreground="Black" CaretBrush="Black" 
                             Background="White" 
                             Padding="10"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             IsReadOnly="{Binding IsCompleted}"
                             Text="{Binding Typed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="TypingBox_PreviewKeyDown"
                             VerticalScrollBarVisibility="Auto"
                             Height="100"
                             FocusVisualStyle="{x:Null}">

                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Padding" Value="9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Row="4" Text="{Binding Status}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,15,0,0"/>
                </Grid>
            </Border>

            <!-- Кнопки внизу -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="Сброс" Style="{StaticResource AnimatedButton}"
                        Command="{Binding ResetCommand}" Margin="5" Click="ResetButton_Click"/>

                <Button Content="Отменить и выйти" Style="{StaticResource AnimatedButton}"
                        Command="{Binding GoBackCommand}"
                        Background="#E0E0E0" Foreground="#333333" Margin="5"/>

                <Button Content="{Binding NextButtonText}" Style="{StaticResource AnimatedButton}"
                        Command="{Binding NextTextCommand}" Margin="5" Click="NextTextButton_Click"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>