<UserControl x:Class="TypingTrainer.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource DarkBgBrush}" MouseMove="MainGrid_MouseMove">

        <!-- Анимированный фон -->
        <Image Source="/Images/234.png" 
               Stretch="UniformToFill" 
               Opacity="0.8"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                    <TranslateTransform x:Name="ImageMovement" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- Затемнение -->
        <Rectangle Fill="{StaticResource DarkBgBrush}" Opacity="0.5" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Background="{StaticResource DarkBrush}" Padding="20,15">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="⌨️ Тренажёр слепой печати"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Foreground="{StaticResource LightBrush}" VerticalAlignment="Center" Margin="0,0,15,0">
                            <Run Text="👤 "/>
                            <Run Text="{Binding CurrentUser.Login}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding CurrentUser.Role}"/>
                            <Run Text=")"/>
                        </TextBlock>

                        <Button Content="Выйти" Style="{StaticResource AnimatedButton}"
                                Command="{Binding LogoutCommand}"
                                Background="#E0E0E0" Foreground="#333333"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Главное меню -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Красивый заголовок (шрифт изменен на Bold) -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,35">
                    <TextBlock Text="Добро пожаловать!" 
                               FontSize="36" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4A0000" Offset="0.0"/>
                                <GradientStop Color="#9C1C1C" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#4A0000" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Декоративная линия -->
                    <Border Height="4" Width="180" Background="#9C1C1C" 
                            CornerRadius="2" Margin="0,8,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#9C1C1C" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                    </Border>
                </StackPanel>

                <!-- Кнопки в разных оттенках бордового -->
                <Button Content="⏱ Тестирование (60 сек)" Width="280"
                        Style="{StaticResource AnimatedButton}"
                        Command="{Binding OpenTestCommand}"
                        Background="#9C1C1C" Foreground="White"/>

                <Button Content="🎯 Уровни (1-90)" Width="280"
                        Style="{StaticResource AnimatedButton}"
                        Command="{Binding OpenLevelsCommand}"
                        Background="#4A0000" Foreground="White"/>

                <Button Content="⌨ Тренировка" Width="280"
                        Style="{StaticResource AnimatedButton}"
                        Command="{Binding OpenTrainerCommand}"
                        Background="#5E1914" Foreground="White"/>

                <Button Content="📊 Статистика и рейтинг" Width="280"
                        Style="{StaticResource AnimatedButton}"
                        Command="{Binding OpenStatisticsCommand}"
                        Background="#6A1B1A" Foreground="White"/>

                <Button Content="👤 Профиль" Width="280"
                        Style="{StaticResource AnimatedButton}"
                        Command="{Binding OpenProfileCommand}"
                        Background="#7B1F1F" Foreground="White"/>

                <Button Content="📖 О программе" Width="280"
                        Style="{StaticResource AnimatedButton}"
                        Command="{Binding OpenAboutCommand}"
                        Background="#8B2626" Foreground="White"/>

                <Button Content="⚙ Администрирование" Width="280"
                        Style="{StaticResource AnimatedButton}"
                        Background="#3A0A0A" Foreground="White"
                        Command="{Binding OpenAdminCommand}"
                        Visibility="{Binding CurrentUser.IsAdmin,
                            Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>