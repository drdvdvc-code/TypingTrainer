<UserControl x:Class="TypingTrainer.Views.LevelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource DarkBgBrush}" MouseMove="MainGrid_MouseMove" ClipToBounds="True">

        <!-- 1. Анимированный фон -->
        <Image Source="/Images/345.png" 
               Stretch="UniformToFill" 
               Opacity="0.8"
               RenderTransformOrigin="0.5,0.5"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                    <TranslateTransform x:Name="ImageMovement" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- 2. Затемнение для читаемости -->
        <Rectangle Fill="{StaticResource DarkBgBrush}" Opacity="0.5" IsHitTestVisible="False"/>

        <!-- 3. Основной интерфейс уровней -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Background="{StaticResource PrimaryBrush}" Padding="20,10">
                <TextBlock Text="🎯 Выбор уровня"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
            </Border>

            <!-- Сетка с уровнями -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30">

                <!-- ⚠️ ИЗМЕНЕНО: MaxWidth увеличен до 850, чтобы кнопки не сжимались -->
                <ItemsControl ItemsSource="{Binding Levels}" HorizontalAlignment="Center" MaxWidth="850">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ⚠️ ИЗМЕНЕНО: Отступы (Margin 10), размер (60x60) и шрифт (22) увеличены -->
                            <Button Content="{Binding Number}"
                                    Style="{StaticResource AnimatedButton}"
                                    Command="{Binding DataContext.SelectLevelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="10" Height="60" Width="60"
                                    FontSize="22" FontWeight="Bold"
                                    Background="{StaticResource PrimaryBrush}" 
                                    Foreground="White"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>

            <!-- Кнопка возврата -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="Назад в меню" Style="{StaticResource AnimatedButton}"
                        Width="250" Command="{Binding GoBackCommand}"
                        Background="#E0E0E0" Foreground="#333333"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>