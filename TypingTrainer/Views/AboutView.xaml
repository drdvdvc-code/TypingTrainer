<UserControl x:Class="TypingTrainer.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource DarkBgBrush}" MouseMove="MainGrid_MouseMove" ClipToBounds="True">

        <!-- 1. Анимированный фон (234.png, как в главном меню) -->
        <Image Source="/Images/234.png" 
               Stretch="UniformToFill" 
               Opacity="0.8"
               RenderTransformOrigin="0.5,0.5"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                    <TranslateTransform x:Name="ImageMovement" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- 2. Затемнение для читаемости -->
        <Rectangle Fill="{StaticResource DarkBgBrush}" Opacity="0.5" IsHitTestVisible="False"/>

        <!-- 3. Белая карточка "О программе" -->
        <Border Width="500" Padding="40" CornerRadius="10"
                Background="{StaticResource DarkBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="📖 О программе" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           TextAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LightBrush}"
                           LineHeight="26" Margin="0,0,0,30" FontSize="15">
                    <Run Text="Программа: " FontWeight="Bold"/>
                    <Run Text="Тренажёр слепой печати v1.0"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="Разработчик: " FontWeight="Bold"/>
                    <Run Text="Давидович Дарья Дмитриевна"/>
                    <LineBreak/>
                    <Run Text="Группа: " FontWeight="Bold"/>
                    <Run Text="22о"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="Контакты: " FontWeight="Bold"/>
                    <Run Text="drdvdvc@gmail.com"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="© 2026. Все права защищены."/>
                </TextBlock>

                <Button Content="Назад в главное меню" Style="{StaticResource AnimatedButton}"
                        Command="{Binding GoBackCommand}"
                        Background="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>