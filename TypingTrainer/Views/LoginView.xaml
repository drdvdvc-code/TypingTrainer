<UserControl x:Class="TypingTrainer.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             FontFamily="{StaticResource UiFont}"
             PreviewKeyDown="LoginView_PreviewKeyDown">
    <!-- ВОТ ЭТА СТРОКА -->

    <Grid>
        <!-- Фон: ГИФКА 123.gif -->
        <Image gif:ImageBehavior.AnimatedSource="/Images/123.gif" 
               Stretch="UniformToFill" Opacity="1.0"/>

        <!-- Затемнение -->
        <Rectangle Fill="{StaticResource DarkBgBrush}" Opacity="0.4"/>

        <!-- Форма входа -->
        <Border Width="380" Padding="30" CornerRadius="10"
                Background="{StaticResource DarkBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel>
                <TextBlock Text="⌨️ Тренажёр слепой печати"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,20" TextAlignment="Center"/>

                <TextBlock Text="Логин" Foreground="{StaticResource LightBrush}"/>
                <TextBox Style="{StaticResource InputBox}"
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Пароль" Foreground="{StaticResource LightBrush}"/>

                <Grid Margin="0,4,0,8">
                    <PasswordBox x:Name="PasswordInput" 
                                 Style="{StaticResource PasswordBox}"
                                 Margin="0" Padding="8,8,35,8"
                                 PasswordChanged="PasswordInput_PasswordChanged"/>

                    <TextBox x:Name="PasswordTextBox" 
                             Style="{StaticResource InputBox}"
                             Margin="0" Padding="8,8,35,8"
                             Visibility="Collapsed"
                             TextChanged="PasswordTextBox_TextChanged"/>

                    <Button x:Name="ShowPasswordBtn" 
                            Content="👁️"
                            Foreground="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            Margin="0,0,5,0" Cursor="Hand" Focusable="False"
                            Click="ShowPasswordBtn_Click"/>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FF5252" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Button Content="Войти" Style="{StaticResource AnimatedButton}"
                        Command="{Binding LoginCommand}" Margin="0,10,0,10"/>

                <Button Content="Зарегистрироваться" Style="{StaticResource AnimatedButton}"
                        Command="{Binding GoToRegisterCommand}"
                        Background="#E0E0E0" Foreground="#333333"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>